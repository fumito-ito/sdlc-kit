{
  "description": "sdlc-kit guards. One definition shared by Claude Code and Codex: both pass tool calls as JSON on stdin, both honour exit code 2 as a block, and Codex sets CLAUDE_PLUGIN_ROOT for compatibility. Codex reports apply_patch edits as tool_name apply_patch and also matches them with Edit|Write.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/sdlc.py\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch|Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/sdlc.py\" hook pre-tool-use",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/bin/sdlc.py\" hook post-tool-use",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
